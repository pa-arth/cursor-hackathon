# Hosted Jev via OpenRouter Decisions (--model jev only; not needed for --model kev)
OPENROUTER_API_KEY=

# Optional: native TypeSafe instead of OpenRouter
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Required for TYPE_TEXT even with --model kev. Decisions are local; typing is a
# separate OpenAI-compatible helper. Same OpenRouter key as above is fine.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# --model kev sets these for you (default :8010). Checkpoint: ../kev/runs/browser-agent-ft/
# TODO(team): keep in sync when serve port/path changes.
# TYPESAFE_BASE_URL=http://127.0.0.1:8010/v1/systemone
# TYPESAFE_API_KEY=local
