# Hosted Jev via OpenRouter Decisions (--model jev)
OPENROUTER_API_KEY=

# Optional: native TypeSafe instead of OpenRouter
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# --model kev sets these for you (default port 8010 for this track; slitherio uses 8009).
# TODO(team): update default URL/comments when the browser-agent FT checkpoint is served.
# TYPESAFE_BASE_URL=http://127.0.0.1:8010/v1/systemone
# TYPESAFE_API_KEY=local
