# Hosted Jev via OpenRouter Decisions (--model jev)
OPENROUTER_API_KEY=

# Optional: native TypeSafe instead of OpenRouter
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Required for TYPE_TEXT fills (nickname, etc.). OpenAI-compatible helper.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# --model kev sets these for you; only override if your server differs
# TYPESAFE_BASE_URL=http://127.0.0.1:8009/v1/systemone
# TYPESAFE_API_KEY=local
